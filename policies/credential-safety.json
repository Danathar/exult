{
    "$comment": "Keeps credentials out of the repository. Evaluated by scripts/check-policies.mjs (checkSecretScan); matches are reported by file and line, never echoed. See docs/security/SECURITY-AI.md, section 'Credentials'.",
    "secretScan": {
        "excludeGlobs": [
            "policies/credential-safety.json"
        ],
        "tokenPatterns": [
            {
                "name": "GitHub token",
                "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,})"
            },
            {
                "name": "LLM API key",
                "pattern": "\\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{30,}"
            },
            {
                "name": "AWS access key ID",
                "pattern": "\\bAKIA[0-9A-Z]{16}\\b"
            },
            {
                "name": "private key block",
                "pattern": "-----BEGIN (?:[A-Z]+ )*PRIVATE KEY-----"
            },
            {
                "name": "Discord webhook URL",
                "pattern": "discord(?:app)?\\.com/api/webhooks/\\d+/[A-Za-z0-9_-]{20,}"
            }
        ]
    }
}
