{
    "$comment": "Keeps every agent's gh write commands on Danathar/exult (a fork: gh defaults to the upstream parent, exult/exult). Evaluated by scripts/check-policies.mjs. See policies/README.md and docs/security/SECURITY-AI.md.",
    "requiredLiteral": "--repo Danathar/exult",
    "directionGlobs": [
        "AGENTS.md",
        "CLAUDE.md",
        ".github/copilot-instructions.md",
        ".cursor/rules/**",
        ".github/prompts/**/*.md",
        ".claude/skills/**/*.md",
        ".claude/memory/README.md",
        "docs/security/SECURITY-AI.md",
        "docs/ai-ops-runbook.md",
        "docs/multi-agent.md",
        "docs/agent-boundaries.md"
    ],
    "scanGlobs": [
        "*.md",
        "docs/**/*.md",
        ".github/**/*.md",
        ".claude/**/*.md",
        "policies/**/*.md"
    ],
    "excludeGlobs": [],
    "writeCommandPattern": "\\bgh(?:\\s+(?:-R|--repo)(?:\\s+|=)(?:\\$\\{\\{[^}]*\\}\\}|\\S+))*\\s+(?:(?:pr|issue|release|workflow|label)(?:\\s+(?:-R|--repo)(?:\\s+|=)(?:\\$\\{\\{[^}]*\\}\\}|\\S+))*\\s+(?:create|comment|edit|close|reopen|merge|review|delete|run|enable|disable|ready|upload|delete-asset|lock|unlock|transfer|pin|unpin|update-branch|revert|clone|develop)|run(?:\\s+(?:-R|--repo)(?:\\s+|=)(?:\\$\\{\\{[^}]*\\}\\}|\\S+))*\\s+(?:rerun|cancel|delete)|repo(?:\\s+(?:-R|--repo)(?:\\s+|=)(?:\\$\\{\\{[^}]*\\}\\}|\\S+))*\\s+(?:create|delete|edit|rename|archive|unarchive|fork|sync)|(?:secret|variable)(?:\\s+(?:-R|--repo)(?:\\s+|=)(?:\\$\\{\\{[^}]*\\}\\}|\\S+))*\\s+(?:set|delete|remove)|gist(?:\\s+(?:-R|--repo)(?:\\s+|=)(?:\\$\\{\\{[^}]*\\}\\}|\\S+))*\\s+(?:create|edit|delete|rename))\\b",
    "repoFlagPattern": "(?:--repo|-R)[ =]Danathar/exult(?![\\w.-])",
    "forbiddenPatterns": [
        "\\bgh(?:\\s+(?:-R|--repo)(?:\\s+|=)(?:\\$\\{\\{[^}]*\\}\\}|\\S+))*\\s+(?:(?:pr|issue|release|workflow|label)(?:\\s+(?:-R|--repo)(?:\\s+|=)(?:\\$\\{\\{[^}]*\\}\\}|\\S+))*\\s+(?:create|comment|edit|close|reopen|merge|review|delete|run|enable|disable|ready|upload|delete-asset|lock|unlock|transfer|pin|unpin|update-branch|revert|clone|develop)|run(?:\\s+(?:-R|--repo)(?:\\s+|=)(?:\\$\\{\\{[^}]*\\}\\}|\\S+))*\\s+(?:rerun|cancel|delete)|repo(?:\\s+(?:-R|--repo)(?:\\s+|=)(?:\\$\\{\\{[^}]*\\}\\}|\\S+))*\\s+(?:create|delete|edit|rename|archive|unarchive|fork|sync)|(?:secret|variable)(?:\\s+(?:-R|--repo)(?:\\s+|=)(?:\\$\\{\\{[^}]*\\}\\}|\\S+))*\\s+(?:set|delete|remove)|gist(?:\\s+(?:-R|--repo)(?:\\s+|=)(?:\\$\\{\\{[^}]*\\}\\}|\\S+))*\\s+(?:create|edit|delete|rename))\\b[^\\n]*?(?:--repo|-R)[ =](?!Danathar/exult(?![\\w.-]))[\\w.-]+/[\\w.-]+",
        "GH_REPO=(?!Danathar/exult(?![\\w.-]))[\\w.-]+/[\\w.-]+",
        "gh\\s+repo\\s+set-default\\s+(?!-|Danathar/exult(?![\\w.-]))\\S+"
    ]
}
