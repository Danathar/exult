{
    "$comment": "docs/risk-tiers.md is the source; this file restates its tier table as data. scripts/check-policies.mjs fails when the two disagree (tier number, name, paths, required commands, review) and when .github/CODEOWNERS lacks an entry for a path whose review is owner. Tier 3 is the MOST dangerous tier. Paths are input to a classifier, not the classifier: tier is set by what a change can break, so a reviewer's judgment can raise a tier above the path match but never lower it below. A path glob cannot see inside a file, so a change to the safety-relevant parts of a Tier 1 or Tier 2 file (see docs/risk-tiers.md, 'Raise the tier') is raised by that rule. The `**/` prefix matches a file at any depth, including the repository root. A path no tier lists gets default_tier.",
    "owner": "@Danathar",
    "default_tier": 2,
    "tiers": [
        {
            "tier": 1,
            "name": "low",
            "paths": [
                "docs/**",
                "**/*.md",
                "**/*.txt",
                "tests/**"
            ],
            "required_commands": [
                "node scripts/check-policies.mjs"
            ],
            "review": "ci"
        },
        {
            "tier": 2,
            "name": "standard",
            "paths": [
                "**/*.cc",
                "**/*.cpp",
                "**/*.h",
                "**/*.hpp",
                "**/*.mm",
                "**/*.uc",
                "**/*.sh",
                "scripts/**"
            ],
            "required_commands": [
                "tests/run-unit-tests.sh",
                "tests/e2e/run.sh",
                "node scripts/check-policies.mjs",
                "node --test 'scripts/tests/*.test.mjs'"
            ],
            "review": "ci"
        },
        {
            "tier": 3,
            "name": "critical",
            "paths": [
                "configure.ac",
                "**/Makefile.am",
                "**/*.mk",
                ".github/**",
                ".claude/settings.json",
                ".claude/hooks/**",
                ".claude/skills/**",
                ".cursor/rules/**",
                "policies/**",
                "scripts/check-policies.mjs",
                "risk-config.json",
                "AGENTS.md",
                "CLAUDE.md",
                "COPYING",
                "docs/risk-tiers.md",
                "docs/agent-boundaries.md",
                "docs/security/**",
                "files/**",
                "gamedat.cc",
                "objs/**"
            ],
            "required_commands": [
                "tests/run-unit-tests.sh",
                "tests/e2e/run.sh",
                "node scripts/check-policies.mjs",
                "node --test 'scripts/tests/*.test.mjs'",
                "node --test '.claude/hooks/tests/*.test.mjs'",
                "actionlint"
            ],
            "review": "owner"
        }
    ]
}
